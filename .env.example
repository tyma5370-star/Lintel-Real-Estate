# All optional — the defaults in src/config.ts point at Devnet and are what the
# demo is verified against. Copy to .env only if you need to override something.

# XRPL_NETWORK_URL=wss://s.devnet.rippletest.net:51233/
# XRPL_FAUCET_URL=https://faucet.devnet.rippletest.net/accounts
# XRPL_EXPLORER=https://devnet.xrpl.org

# How the ledger interprets Loan.InterestRate. Verified empirically as 'annual'
# on Devnet (rippled 3.3.0-rc5) — see docs/verified.md V8. Override only if a
# future amendment changes it, and re-run `npm run lifecycle` to re-probe.
# INTEREST_RATE_BASIS=annual

# HTTP API port.
# PORT=8787
